{
  "provider_type": {
    "description": "PT 站点类型，可选 gaytorrents、nexusphp 或 mteam。",
    "type": "string",
    "hint": "gaytorrents / nexusphp / mteam",
    "default": "gaytorrents"
  },
  "provider_base_url": {
    "description": "PT 站点地址，默认 Gay-Torrents。",
    "type": "string",
    "hint": "https://www.gay-torrents.net/",
    "default": "https://www.gay-torrents.net/"
  },
  "provider_search_path": {
    "description": "搜索路径，必须包含 {keyword} 占位符。",
    "type": "string",
    "hint": "GT_torrents/GT_ajax_search.php?filename={keyword}",
    "default": "GT_torrents/GT_ajax_search.php?filename={keyword}"
  },
  "provider_cookie": {
    "description": "PT 站登录 Cookie，用于搜索和下载 .torrent 文件。Gay-Torrents 留空时会用下面的账号密码自动登录。",
    "type": "string",
    "hint": "从浏览器开发者工具复制 Cookie 请求头",
    "default": ""
  },
  "provider_username": {
    "description": "PT 站账号，Gay-Torrents 自动登录使用。",
    "type": "string",
    "hint": "留空则只使用 Cookie",
    "default": ""
  },
  "provider_password": {
    "description": "PT 站密码，Gay-Torrents 自动登录使用。",
    "type": "string",
    "hint": "敏感信息，建议只在私聊用 /种子配置 设置",
    "default": ""
  },
  "mteam_api_token": {
    "description": "M-Team API Token。",
    "type": "string",
    "hint": "仅 provider_type=mteam 时使用，敏感信息",
    "default": ""
  },
  "mteam_search_path": {
    "description": "M-Team API 搜索路径。",
    "type": "string",
    "hint": "/api/torrent/search",
    "default": "/api/torrent/search"
  },
  "mteam_download_path": {
    "description": "M-Team 获取临时下载链接的 API 路径。",
    "type": "string",
    "hint": "/api/torrent/genDlToken",
    "default": "/api/torrent/genDlToken"
  },
  "download_client": {
    "description": "下载客户端类型，可选 qbittorrent 或 utorrent。",
    "type": "string",
    "hint": "qbittorrent / utorrent",
    "default": "qbittorrent"
  },
  "qb_url": {
    "description": "qBittorrent WebUI 地址。",
    "type": "string",
    "hint": "http://127.0.0.1:8080",
    "default": ""
  },
  "qb_username": {
    "description": "qBittorrent WebUI 用户名。",
    "type": "string",
    "hint": "可留空",
    "default": ""
  },
  "qb_password": {
    "description": "qBittorrent WebUI 密码。",
    "type": "string",
    "hint": "可留空",
    "default": ""
  },
  "qb_save_path": {
    "description": "可选：qBittorrent 保存路径。",
    "type": "string",
    "hint": "例如 /downloads/PT",
    "default": ""
  },
  "qb_category": {
    "description": "可选：qBittorrent 分类。",
    "type": "string",
    "hint": "例如 PT",
    "default": ""
  },
  "qb_paused": {
    "description": "添加任务后是否暂停。",
    "type": "bool",
    "default": false
  },
  "ut_url": {
    "description": "uTorrent WebUI 地址，选择 utorrent 时必填。",
    "type": "string",
    "hint": "http://127.0.0.1:8080",
    "default": ""
  },
  "ut_username": {
    "description": "uTorrent WebUI 用户名。",
    "type": "string",
    "hint": "可留空",
    "default": ""
  },
  "ut_password": {
    "description": "uTorrent WebUI 密码。",
    "type": "string",
    "hint": "可留空",
    "default": ""
  },
  "aria2_rpc_url": {
    "description": "aria2 JSON-RPC 地址，/下载 识别为普通直链的任务会交给 aria2。",
    "type": "string",
    "hint": "http://127.0.0.1:6800/jsonrpc",
    "default": "http://127.0.0.1:6800/jsonrpc"
  },
  "aria2_rpc_token": {
    "description": "aria2 RPC 密钥，对应 aria2 的 --rpc-secret。",
    "type": "string",
    "hint": "可留空",
    "default": ""
  },
  "aria2_save_path": {
    "description": "可选：aria2 下载保存目录，留空则使用 aria2 自身的默认目录。",
    "type": "string",
    "hint": "例如 /downloads/botdownload",
    "default": ""
  },
  "ytdlp_api_url": {
    "description": "yt-dlp 服务地址，/下载 识别为视频网页的链接会交给它解析下载。",
    "type": "string",
    "hint": "http://127.0.0.1:5000",
    "default": ""
  },
  "ytdlp_api_key": {
    "description": "yt-dlp 服务的 API Key（请求头 X-API-Key）。",
    "type": "string",
    "hint": "可留空",
    "default": ""
  },
  "ytdlp_format": {
    "description": "可选：yt-dlp 视频格式，对应服务的 video_format 参数。",
    "type": "string",
    "hint": "例如 bestvideo",
    "default": ""
  },
  "video_hosts": {
    "description": "额外的视频站域名，逗号分隔，命中后交给 yt-dlp。",
    "type": "string",
    "hint": "例如 example.com,other.site",
    "default": ""
  },
  "direct_torrent_max_size_mb": {
    "description": "直接下载 HTTP(S) 种子链接时允许的最大响应大小，防止误传大文件。",
    "type": "int",
    "hint": "1-500",
    "default": 50
  },
  "max_results": {
    "description": "每次搜索最多返回结果数。",
    "type": "int",
    "hint": "1-30",
    "default": 10
  },
  "cache_ttl_seconds": {
    "description": "搜索结果选择缓存时间，默认 600 秒（10 分钟），超时后需重新搜索。",
    "type": "int",
    "hint": "60-3600",
    "default": 600
  },
  "render_width": {
    "description": "结果卡片渲染宽度，插件会按结果数量自动计算高度。",
    "type": "int",
    "hint": "640-1400",
    "default": 900
  },
  "request_timeout": {
    "description": "网络请求超时时间，单位秒。",
    "type": "float",
    "hint": "5-120",
    "default": 20
  },
  "monitor_enabled": {
    "description": "是否监控 qBittorrent 下载状态，并定时向添加者汇报。",
    "type": "bool",
    "hint": "只支持 qBittorrent WebAPI，uTorrent 不会被监控。",
    "default": true
  },
  "monitor_interval_minutes": {
    "description": "下载状态汇报间隔，单位分钟。",
    "type": "int",
    "hint": "1-120",
    "default": 5
  },
  "monitor_max_hours": {
    "description": "单个任务最长监控时长，单位小时，超时后停止汇报。",
    "type": "int",
    "hint": "1-168",
    "default": 12
  },
  "monitor_report_progress": {
    "description": "是否每个周期都汇报下载进度。",
    "type": "bool",
    "hint": "关闭后只在下载完成或任务消失时通知。",
    "default": true
  },
  "monitor_complete_message": {
    "description": "下载完成时发送的提示词。",
    "type": "string",
    "hint": "留空则使用默认提示词。",
    "default": "种子已下载完成，请登录群网盘-桌面botdownload文件夹查看"
  },
  "access_whitelist": {
    "description": "插件用户白名单",
    "type": "list",
    "hint": "填写允许使用插件的 QQ 号。留空表示不启用白名单。",
    "default": []
  },
  "access_blacklist": {
    "description": "插件用户黑名单",
    "type": "list",
    "hint": "填写禁止使用插件的 QQ 号。普通用户同时命中两个名单时黑名单优先。",
    "default": []
  },
  "access_admin_bypass": {
    "description": "AstrBot 管理员是否绕过白名单和黑名单",
    "type": "bool",
    "hint": "管理员身份使用 AstrBot 中配置的管理员 ID 判断。",
    "default": true
  },
  "global_config_admin_only": {
    "description": "全局 PT 与下载客户端配置是否仅 AstrBot 管理员可用",
    "type": "bool",
    "hint": "开启后，普通用户不会继承上方全局配置，只使用自己的用户配置和插件内置默认值。",
    "default": false
  },
  "enable_user_config_commands": {
    "description": "是否允许用户在群聊或私聊中维护自己的配置。",
    "type": "bool",
    "default": true
  },
  "user_profiles": {
    "description": "QQ 用户独立配置",
    "type": "template_list",
    "hint": "按 QQ 号维护独立的 PT 站点和下载客户端配置。用户也可以通过 /种子配置 命令自行维护。",
    "default": [],
    "templates": {
      "user": {
        "name": "QQ 用户配置",
        "description": "QQ 用户配置",
        "items": {
          "qq": {
            "description": "QQ 号",
            "type": "string",
            "hint": "必须与消息事件中的发送者 QQ 号一致。",
            "default": ""
          },
          "provider_type": {
            "description": "PT 站点类型",
            "type": "string",
            "options": ["gaytorrents", "nexusphp", "mteam"],
            "default": "gaytorrents"
          },
          "provider_base_url": {
            "description": "PT 站点地址",
            "type": "string",
            "hint": "https://www.gay-torrents.net/",
            "default": "https://www.gay-torrents.net/"
          },
          "provider_search_path": {
            "description": "搜索路径",
            "type": "string",
            "hint": "必须包含 {keyword} 占位符。",
            "default": "GT_torrents/GT_ajax_search.php?filename={keyword}"
          },
          "provider_cookie": {
            "description": "PT 站登录 Cookie",
            "type": "string",
            "hint": "敏感信息，请勿公开。",
            "default": ""
          },
          "provider_username": {
            "description": "PT 站账号",
            "type": "string",
            "hint": "Gay-Torrents 自动登录使用。",
            "default": ""
          },
          "provider_password": {
            "description": "PT 站密码",
            "type": "string",
            "hint": "敏感信息，请勿公开。",
            "default": ""
          },
          "mteam_api_token": {
            "description": "M-Team API Token",
            "type": "string",
            "hint": "敏感信息",
            "default": "",
            "condition": {"provider_type": "mteam"}
          },
          "mteam_search_path": {
            "description": "M-Team API 搜索路径",
            "type": "string",
            "default": "/api/torrent/search",
            "condition": {"provider_type": "mteam"}
          },
          "mteam_download_path": {
            "description": "M-Team 获取下载链接路径",
            "type": "string",
            "default": "/api/torrent/genDlToken",
            "condition": {"provider_type": "mteam"}
          },
          "download_client": {
            "description": "下载客户端",
            "type": "string",
            "hint": "qbittorrent / utorrent",
            "options": ["qbittorrent", "utorrent"],
            "default": "qbittorrent"
          },
          "qb_url": {
            "description": "qBittorrent WebUI 地址",
            "type": "string",
            "hint": "http://127.0.0.1:8080",
            "default": "",
            "condition": {"download_client": "qbittorrent"}
          },
          "qb_username": {
            "description": "qBittorrent 用户名",
            "type": "string",
            "default": "",
            "condition": {"download_client": "qbittorrent"}
          },
          "qb_password": {
            "description": "qBittorrent 密码",
            "type": "string",
            "hint": "敏感信息，请勿公开。",
            "default": "",
            "condition": {"download_client": "qbittorrent"}
          },
          "qb_save_path": {
            "description": "qBittorrent 保存路径",
            "type": "string",
            "default": "",
            "condition": {"download_client": "qbittorrent"}
          },
          "qb_category": {
            "description": "qBittorrent 分类",
            "type": "string",
            "default": "",
            "condition": {"download_client": "qbittorrent"}
          },
          "qb_paused": {
            "description": "添加任务后是否暂停",
            "type": "bool",
            "default": false,
            "condition": {"download_client": "qbittorrent"}
          },
          "ut_url": {
            "description": "uTorrent WebUI 地址",
            "type": "string",
            "hint": "http://127.0.0.1:8080",
            "default": "",
            "condition": {"download_client": "utorrent"}
          },
          "ut_username": {
            "description": "uTorrent 用户名",
            "type": "string",
            "default": "",
            "condition": {"download_client": "utorrent"}
          },
          "ut_password": {
            "description": "uTorrent 密码",
            "type": "string",
            "hint": "敏感信息，请勿公开。",
            "default": "",
            "condition": {"download_client": "utorrent"}
          },
          "aria2_rpc_url": {
            "description": "aria2 RPC 地址",
            "type": "string",
            "hint": "http://127.0.0.1:6800/jsonrpc",
            "default": "http://127.0.0.1:6800/jsonrpc"
          },
          "aria2_rpc_token": {
            "description": "aria2 RPC 密钥",
            "type": "string",
            "hint": "敏感信息，请勿公开。",
            "default": ""
          },
          "aria2_save_path": {
            "description": "aria2 保存路径",
            "type": "string",
            "hint": "例如 /downloads/botdownload",
            "default": ""
          },
          "ytdlp_api_url": {
            "description": "yt-dlp 服务地址",
            "type": "string",
            "hint": "http://127.0.0.1:5000",
            "default": ""
          },
          "ytdlp_api_key": {
            "description": "yt-dlp API Key",
            "type": "string",
            "hint": "敏感信息，请勿公开。",
            "default": ""
          },
          "ytdlp_format": {
            "description": "yt-dlp 视频格式",
            "type": "string",
            "hint": "例如 bestvideo",
            "default": ""
          },
          "video_hosts": {
            "description": "额外的视频站域名",
            "type": "string",
            "hint": "逗号分隔，例如 example.com,other.site",
            "default": ""
          },
          "direct_torrent_max_size_mb": {
            "description": "直链种子大小上限（MB）",
            "type": "int",
            "hint": "1-500",
            "default": 50
          },
          "max_results": {
            "description": "最大搜索结果数",
            "type": "int",
            "hint": "1-30",
            "default": 10
          },
          "cache_ttl_seconds": {
            "description": "搜索缓存时间（秒）",
            "type": "int",
            "hint": "60-3600",
            "default": 600
          },
          "render_width": {
            "description": "结果卡片宽度",
            "type": "int",
            "hint": "640-1400",
            "default": 900
          },
          "request_timeout": {
            "description": "请求超时（秒）",
            "type": "float",
            "hint": "5-120",
            "default": 20
          },
          "monitor_enabled": {
            "description": "下载状态监控",
            "type": "bool",
            "hint": "关闭后不汇报下载进度，也不会收到完成提醒。",
            "default": true
          }
        }
      }
    }
  }
}
